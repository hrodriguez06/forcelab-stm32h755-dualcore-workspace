{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "Dual-Core Debug (CM7 + CM4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Dual-Core Release (CM7 + CM4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "selftest",
      "displayName": "Dual-Core Debug with DMA Selftest (CM7 + CM4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ADC_DRIVER_SELFTEST": "OFF",
        "DMA_DRIVER_SELFTEST": "ON"
      }
    },
    {
      "name": "selftest-adc",
      "displayName": "Dual-Core Debug with ADC Selftest (CM7 + CM4)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-adc",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ADC_DRIVER_SELFTEST": "ON",
        "DMA_DRIVER_SELFTEST": "OFF"
      }
    },
    {
      "name": "selftest-uart",
      "displayName": "Dual-Core Debug with UART Selftest (CM7 + CM4, PD5-PD6 wire)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-uart",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "UART_DRIVER_SELFTEST": "ON",
        "ADC_DRIVER_SELFTEST": "OFF",
        "DMA_DRIVER_SELFTEST": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "debug",         "configurePreset": "debug"         },
    { "name": "release",       "configurePreset": "release"       },
    { "name": "selftest",      "configurePreset": "selftest"      },
    { "name": "selftest-adc",  "configurePreset": "selftest-adc"  },
    { "name": "selftest-uart", "configurePreset": "selftest-uart" }
  ]
}
