# Normalise line endings once, here, at the initial commit. Doing it later
# rewrites every file in the index and buries a real change in the noise.
* text=auto

# Shell scripts must be LF whatever the host: CRLF makes a POSIX shell fail
# with "bad interpreter".
*.sh        text eol=lf
*.py        text eol=lf

# PowerShell is happiest with CRLF on Windows, which is the only place these run.
*.ps1       text eol=crlf

# Linker scripts, startup assembly and CMake are plain text everywhere.
*.ld        text
*.s         text
*.cmake     text

# The vendored ST package is kept byte for byte as shipped. Normalising it would
# rewrite 66 854 lines of ST's own example projects on the first commit and make
# every future diff against a fresh download unreadable. Their line endings are
# ST's problem, not this repository's.
00_docs_stm32h7/docs/01_drivers_and_hal/STM32CubeH7/** -text

# ...except the note explaining the prune, which is ours and follows our rules.
00_docs_stm32h7/docs/01_drivers_and_hal/STM32CubeH7/PRUNED.md text

# Never normalise these, even though most are gitignored - a stray one must not
# be corrupted by EOL translation.
*.pdf       binary
*.bin       binary
*.hex       binary
*.elf       binary
*.ioc       text eol=lf
