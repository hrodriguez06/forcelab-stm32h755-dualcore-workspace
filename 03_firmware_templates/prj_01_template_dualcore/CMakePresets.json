{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "debug",
      "displayName": "CM7 Debug (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "FW_PRESET": "debug" }
    },
    {
      "name": "release",
      "displayName": "CM7 Release (Ninja)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "FW_PRESET": "release" }
    },
    {
      "name": "selftest-gpio",
      "displayName": "Dual-Core Debug with the 00_gpio selftest (AD2 bench)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-gpio",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "GPIO_DRIVER_SELFTEST": "ON", "FW_PRESET": "selftest-gpio" }
    },
    {
      "name": "selftest-tim",
      "displayName": "Dual-Core Debug with the 03_tim selftest (AD2 bench)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-tim",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "TIM_DRIVER_SELFTEST": "ON", "FW_PRESET": "selftest-tim" }
    },
    {
      "name": "selftest-spi",
      "displayName": "Dual-Core Debug with the 06_spi selftest (AD2 bench, J1)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-spi",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "SPI_DRIVER_SELFTEST": "ON", "FW_PRESET": "selftest-spi" }
    },
    {
      "name": "selftest-i2c",
      "displayName": "Dual-Core Debug with the 05_i2c selftest (AD2 bench, I2C bus, F334 target)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-i2c",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "I2C_DRIVER_SELFTEST": "ON", "FW_PRESET": "selftest-i2c" }
    },
    {
      "name": "selftest-uart",
      "displayName": "Dual-Core Debug with the 04_uart selftest (AD2 bench, JU1/JU2)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/selftest-uart",
      "toolchainFile": "${sourceDir}/cmake/arm-none-eabi.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "UART_DRIVER_SELFTEST": "ON", "FW_PRESET": "selftest-uart" }
    }
  ],
  "buildPresets": [
    { "name": "debug",         "configurePreset": "debug"         },
    { "name": "release",       "configurePreset": "release"       },
    { "name": "selftest-gpio", "configurePreset": "selftest-gpio" },
    { "name": "selftest-tim",  "configurePreset": "selftest-tim"  },
    { "name": "selftest-spi",  "configurePreset": "selftest-spi"  },
    { "name": "selftest-i2c",  "configurePreset": "selftest-i2c"  },
    { "name": "selftest-uart", "configurePreset": "selftest-uart" }
  ]
}
